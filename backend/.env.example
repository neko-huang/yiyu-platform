# ===========================================
# 益屿活动管理平台 — 环境变量配置示例
# 复制此文件为 .env 并修改对应值
# ===========================================

# ---- 数据库 ----
# SQLite（开发默认）或 PostgreSQL 连接串
DATABASE_URL=sqlite+aiosqlite:///./data/yiyu.db

# ---- JWT 认证 ----
# 生产环境必须设置为一个足够长的随机字符串！
# 可使用: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Token 过期时间（小时）
ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- CORS 跨域 ----
# 允许的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- DeepSeek AI ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- 高德地图 ----
# 获取地址：https://lbs.amap.com/ → 创建应用 → Web服务 → 获取 Key
# 与前端 VITE_AMAP_KEY 使用同一个 Key 即可
AMAP_KEY=
